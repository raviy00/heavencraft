# ──────────────────────────────────────────────────────────────
#  Heavencraft — Frontend Environment Variables
#  Copy to .env.local for local development.
#  In production, deploy.sh auto-generates .env.production.
# ──────────────────────────────────────────────────────────────

# API base URL — set to your backend URL (no trailing slash)
# Local dev: http://localhost:3001/api
# Production: set automatically by deploy.sh
VITE_API_URL=http://localhost:3001/api

# Minecraft server IP shown on the homepage
VITE_SERVER_IP=play.heavencraft.net
