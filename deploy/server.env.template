# ============================================================
#  Heavencraft Server — Environment Variables Template
#  Copy this to server/.env and fill in your real values.
#  The deploy.sh script auto-fills the URL fields below.
# ============================================================

PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/heavencraft?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production!
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_string

# ── Discord OAuth ────────────────────────────────────────────
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=http://SERVER_NAME/api/auth/discord/callback

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://SERVER_NAME/api/auth/google/callback

# ── Microsoft OAuth ──────────────────────────────────────────
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_REDIRECT_URI=http://SERVER_NAME/api/auth/microsoft/callback

# ── Frontend URL (auto-updated by deploy.sh) ─────────────────
FRONTEND_URL=http://SERVER_NAME

# ── Minecraft Server Management ──────────────────────────────
MC_MANAGEMENT_WS=wss://play.heavencraft.net:25585
MC_MANAGEMENT_TOKEN=

# ── Email (Nodemailer) ───────────────────────────────────────
EMAIL_USER=hevancraftsmp@gmail.com
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD

# ── Map ──────────────────────────────────────────────────────
MAP_SEED=-4399806456249969304
